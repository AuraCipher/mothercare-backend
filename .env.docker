# ── Local Production-Like Environment ──────────────────────
# Copy this file to .env and fill in values as needed.
# Docker Compose overrides these with its own environment block.
# This template is for manual `npm start` outside Docker.

NODE_ENV=production
APP_MODE=production
PORT=5000
HOST=0.0.0.0

# ── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://mcs:mcs_dev_password@localhost:5432/mothercare?schema=public"

# ── Redis (TCP — BullMQ queues) ────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Redis (Upstash REST — JWT blacklist, optional) ─────────
# Leave unset to skip JWT blacklisting (non-critical).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET="local-dev-jwt-secret-minimum-32-characters-long"
JWT_EXPIRY=7d

# ── App URLs ───────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:5000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080"

# ── School ─────────────────────────────────────────────────
SCHOOL_NAME="Mother Care School"
DEFAULT_BRANCH_NAME="Mother Care Sohan"

# ── Queue Concurrency ──────────────────────────────────────
MESSAGE_QUEUE_CONCURRENCY=3
CHAT_QUEUE_CONCURRENCY=5

# ── External Services (leave blank for local) ──────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# RESEND_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# ── Firebase / FCM ────────────────────────────────────────
FCM_ENABLED=false
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Sentry ─────────────────────────────────────────────────
# SENTRY_DSN=
